<?xml version="1.0"?>
<sdf version="1.9">
  <model name="survivor">
    <static>true</static>
    <link name="link">
      <!-- Simple lying-down human proxy: torso box + head sphere, bright
           orange for visibility from altitude (stand-in for a rescue
           mannequin / textured actor per the Phase 0.4 implementation-plan
           note). No physics/actor plugin needed — these exist purely as
           fixed, known-position visual targets for detection + geotagging
           accuracy validation (Phase 3.4). -->
      <collision name="torso_collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <box>
            <size>1.7 0.45 0.3</size>
          </box>
        </geometry>
      </collision>

      <visual name="torso_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <box>
            <size>1.7 0.45 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.35 0.05 1</ambient>
          <diffuse>0.95 0.4 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <visual name="head_visual">
        <pose>0.95 0 0.2 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.18</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.55 1</ambient>
          <diffuse>0.95 0.75 0.6 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
