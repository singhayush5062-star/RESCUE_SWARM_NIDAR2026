<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nidar_mission_executor</name>
  <version>0.1.0</version>
  <description>Multi-drone flight orchestration (boundary-to-coverage auto-planning and JSON-waypoint missions) and manual arm/disarm/takeoff drone control for NIDAR RescueSwarm. Owns the persistent per-drone AS2 interface pool shared by both.</description>
  <maintainer email="singhayush5062@gmail.com">ayush</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nidar_msgs</depend>
  <depend>nidar_mission_manager</depend>
  <depend>as2_python_api</depend>
  <depend>ros_gz_interfaces</depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
